{
  "name": "StudentAnswer",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "Atividade"
    },
    "turma_id": {
      "type": "string",
      "title": "Turma"
    },
    "student_id": {
      "type": "string",
      "title": "Aluno"
    },
    "student_name": {
      "type": "string",
      "title": "Nome do aluno"
    },
    "selected_option": {
      "type": "string",
      "title": "Diagn\u00f3stico escolhido"
    },
    "rationale": {
      "type": "string",
      "title": "Justificativa"
    },
    "is_correct": {
      "type": "boolean",
      "title": "Resposta correta"
    }
  },
  "required": [
    "assignment_id",
    "student_id",
    "selected_option"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
