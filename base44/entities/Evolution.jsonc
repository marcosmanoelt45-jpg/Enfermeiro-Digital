{
  "name": "Evolution",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "subjective": {
      "type": "string",
      "title": "Subjetivo (S)"
    },
    "objective": {
      "type": "string",
      "title": "Objetivo (O)"
    },
    "assessment": {
      "type": "string",
      "title": "Avalia\u00e7\u00e3o (A)"
    },
    "plan": {
      "type": "string",
      "title": "Plano (P)"
    },
    "signed": {
      "type": "boolean",
      "title": "Assinado",
      "default": false
    }
  },
  "required": [
    "patient_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
