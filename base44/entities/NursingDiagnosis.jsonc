{
  "name": "NursingDiagnosis",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string",
      "title": "Paciente"
    },
    "code": {
      "type": "string",
      "title": "C\u00f3digo NANDA-I"
    },
    "title": {
      "type": "string",
      "title": "T\u00edtulo do diagn\u00f3stico"
    },
    "domain": {
      "type": "string",
      "title": "Dom\u00ednio"
    },
    "class": {
      "type": "string",
      "title": "Classe"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "resolvido",
        "inativo"
      ],
      "title": "Status",
      "default": "ativo"
    },
    "source_link": {
      "type": "string",
      "title": "Link da fonte"
    },
    "defining_characteristics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Caracter\u00edsticas Definidoras"
    },
    "related_factors": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Fatores Relacionados"
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Interven\u00e7\u00f5es (NIC)"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Resultados (NOC)"
    },
    "notes": {
      "type": "string",
      "title": "Observa\u00e7\u00f5es"
    },
    "assessment_id": {
      "type": "string",
      "title": "Avalia\u00e7\u00e3o de origem"
    }
  },
  "required": [
    "patient_id",
    "code",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
